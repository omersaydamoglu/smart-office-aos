# Yerel geliştirme değerleri (docker-compose.yml ile uyumlu). Üretimde kullanmayın.
# Başka bir PostgreSQL 5432'yi tutuyorsa docker-compose.yml'deki dış portu ve buradaki portu değiştirin (docs/kurulum.md, Bölüm 4.1).
DATABASE_URL="postgresql://aos:aos_dev_pass@localhost:5432/smart_office"
JWT_SECRET="gelistirme-icin-uzun-rastgele-bir-metin"
PORT=3000

# Cookie ile istek atabilecek frontend adresleri (virgulle ayrilir)
CORS_ORIGIN=http://localhost:5173
